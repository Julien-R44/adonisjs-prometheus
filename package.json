{
  "name": "@julr/adonisjs-prometheus",
  "type": "module",
  "version": "2.0.0-next.1",
  "packageManager": "pnpm@10.30.3",
  "description": "Prometheus wrapper for AdonisJS",
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "license": "MIT",
  "homepage": "https://github.com/Julien-R44/adonis5-prometheus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Julien-R44/adonis5-prometheus.git"
  },
  "bugs": {
    "url": "https://github.com/Julien-R44/adonis5-prometheus/issues"
  },
  "keywords": [
    "adonisjs",
    "adonis",
    "prometheus",
    "adonis-prometheus",
    "monitoring",
    "grafana"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./prometheus_provider": "./build/providers/prometheus_provider.js",
    "./collectors/*": "./build/src/collectors/*.js",
    "./controllers/prometheus_metric_controller": "./build/src/controllers/prometheus_metric_controller.js"
  },
  "files": [
    "build"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "pretest": "pnpm lint",
    "test": "c8 pnpm quick:test",
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "compile": "pnpm lint && pnpm clean && tsc && npm run copy:templates",
    "build": "pnpm compile",
    "release": "pnpm build && pnpm release-it",
    "version": "pnpm build",
    "format": "oxfmt --write .",
    "prepublishOnly": "pnpm build",
    "lint": "oxlint .",
    "quick:test": "node --import=@poppinss/ts-exec --enable-source-maps bin/test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0-next.30",
    "@adonisjs/cache": "^2.0.1-next.1",
    "@adonisjs/core": "^7.0.0-next.25",
    "@adonisjs/lucid": "^22.0.0-next.7",
    "@adonisjs/mail": "^10.0.0-next.1",
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/mail": {
      "optional": true
    },
    "@adonisjs/lucid": {
      "optional": true
    },
    "@adonisjs/cache": {
      "optional": true
    },
    "@opentelemetry/api": {
      "optional": true
    },
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "dependencies": {
    "@bentocache/plugin-prometheus": "^0.2.0",
    "ipaddr.js": "^2.3.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/cache": "^2.0.1",
    "@adonisjs/core": "^7.0.0",
    "@adonisjs/lucid": "^22.0.0",
    "@adonisjs/mail": "^10.0.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/file-system": "^3.0.0",
    "@japa/runner": "^5.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/node": "^25.3.3",
    "c8": "^11.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^7.0.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "release-it": "^19.2.4",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  }
}
